#!/usr/bin/env ruby
# frozen_string_literal: true

# Force unbuffered stdout — without this, Ruby fully-buffers when stdout is a
# pipe (e.g. docker log capture) and Rails.logger.info messages sit in the
# buffer until 4KB accumulates or the process exits. Long-running idle
# workers appear silent for hours otherwise.
STDOUT.sync = true
STDERR.sync = true

require_relative "../config/environment"

# Which tube consumers to run (see Ingest::Worker): "ingest" (default) = the
# real-time data tubes; "maintenance" = splat.maintenance; "all", or several
# names, = each role in a process of its own, forked from this one after boot
# and watched by it (see Ingest::Supervisor). One role runs in this process.
roles = Ingest::Worker.roles_for(ARGV.empty? ? ENV.fetch("WORKER_ROLE", "ingest") : ARGV)

if roles.size == 1
  Ingest::Worker.run(roles.first, Ingest::Worker.consumers_for(roles.first))
else
  Ingest::Supervisor.new(roles).run
end
