<%# One endpoint on the performance page's clock: the project page's endpoint
    row (projects/timeline/_endpoint) with the count and p50 beside its time
    and p95, since this page is where an endpoint is weighed. p50 beside p95
    says whether it's slow every time or only in its tail; a p99 would rest
    on its few slowest sampled requests, so it's in the tooltip. A p95 line
    when it has enough requests a bucket, a dot per bucket when it hasn't. %>
<% stats = endpoint.stats %>
<div class="<%= lane %> py-1" data-endpoint="<%= endpoint.name %>">
  <div class="flex items-center gap-1.5 min-w-0">
    <%= link_to endpoint.name, detail_project_endpoints_path(project.slug, name: endpoint.name, **range_params),
        class: "truncate font-mono text-xs text-gray-800 dark:text-gray-200 hover:underline", title: endpoint.name %>
    <% if stats["n_plus_one_count"].to_i.positive? %>
      <% share = (100.0 * stats["n_plus_one_count"] / stats["count"].to_i.clamp(1, nil)).round %>
      <span class="shrink-0 px-1 rounded border text-[10px] font-semibold text-orange-700 border-orange-300 dark:text-orange-300 dark:border-orange-800"
            title="<%= share %>% of its requests repeated a query in a loop">N+1</span>
    <% end %>
  </div>
  <svg viewBox="0 0 480 24" class="w-full h-6 cursor-pointer" preserveAspectRatio="none" aria-hidden="true"
       data-timeline-href="<%= detail_project_endpoints_path(project.slug, name: endpoint.name, sort: "slowest") %>" data-timeline-hint="click for its slowest">
    <path class="stroke-gray-200 dark:stroke-gray-800" stroke-width="1" vector-effect="non-scaling-stroke" d="M0 23.5H480"/>
    <% if endpoint.line? %>
      <% line = timeline_line(endpoint.p95s.map { it.to_i.positive? ? it : nil }, height: 24) %>
      <path class="fill-amber-500/15" d="<%= line[:area] %>"/>
      <path class="fill-none stroke-amber-500" stroke-width="1.5" stroke-linejoin="round" vector-effect="non-scaling-stroke" d="<%= line[:line] %>"/>
    <% else %>
      <path class="fill-amber-500" d="<%= timeline_dots(endpoint.p95s, height: 24) %>"/>
    <% end %>
  </svg>
  <%# What the old table's other columns said, kept for whoever wants it. %>
  <% queries = stats["max_queries"].to_i.positive? ? " · queries avg #{stats["avg_queries"]}, max #{stats["max_queries"]}" : "" %>
  <div class="text-right text-xs tabular-nums whitespace-nowrap"
       title="<%= number_with_delimiter(stats["count"]) %> transactions · p50 <%= format_duration(stats["p50_duration"]) %> · p95 <%= format_duration(stats["p95_duration"]) %> · p99 <%= format_duration(stats["p99_duration"]) %><%= queries %>">
    <%= time_spent_tag(stats, class: "inline-block w-16 font-semibold text-gray-900 dark:text-gray-100") %>
    <span class="inline-block w-12 text-gray-500 dark:text-gray-400" data-count><%= timeline_k(stats["count"]) %></span>
    <span class="inline-block w-14 text-gray-500 dark:text-gray-400"><%= format_duration(stats["p50_duration"]) %></span>
    <span class="inline-block w-14 text-gray-700 dark:text-gray-300"><%= format_duration(stats["p95_duration"]) %></span>
    <% unless endpoint.line? %>
      <div class="text-[10px] text-gray-400 dark:text-gray-500">~<%= (stats["count"].to_f / timeline.buckets).round(1) %> <%= per %>: too few for a p95</div>
    <% end %>
  </div>
</div>
