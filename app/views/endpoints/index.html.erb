<%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @project, "transactions" %>

<%# The project page's clock, for performance alone (PerformanceTimeline):
    requests, jobs and anything else each get their own throughput and p95
    rows, and their own list of where the time went, on the one time axis. %>
<% t = @timeline %>
<% lane = "grid grid-cols-[var(--lbl)_minmax(0,1fr)_var(--val)] gap-x-(--gap) items-center" %>
<% row = "#{lane} border-t border-gray-100 dark:border-gray-800" %>
<% head = "#{lane} pt-4 pb-1 text-[11px] font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400" %>
<% aside = "normal-case tracking-normal font-normal" %>
<% per = timeline_per_bucket(t) %>
<% partial = t.partial_last_bucket? %>
<% pill = ->(current) { "px-2.5 py-1 rounded text-xs font-medium whitespace-nowrap #{current ? "bg-white dark:bg-gray-700 text-gray-900 dark:text-white shadow-sm" : "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white"}" } %>
<% pills = "flex gap-0.5 p-0.5 rounded-md border border-gray-200 dark:border-gray-800 bg-gray-100 dark:bg-gray-900" %>
<%
  nouns = {"web" => "requests", "job" => "jobs", "other" => "transactions"}
  signal_labels = {"web" => "Requests", "job" => "Jobs", "other" => "Other"}
  section_labels = {"web" => "web requests", "job" => "background jobs", "other" => "other"}
  filters = {kind: @kind, environment: @environment, name: @name_query}.compact
  all_count = t.totals.values.sum { it[:count] }
%>

<div class="py-4">
  <div class="mb-1"><%= breadcrumbs([@project.name, project_path(@project.slug)], ["Performance", nil]) %></div>

  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-3">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Performance</h1>

    <% if @window %>
      <%= render "shared/window_steps", window: @window %>
      <%= link_to "last #{@time_range}", current_page_with(drop: %w[from to]),
          class: "text-sm text-blue-600 dark:text-blue-400 hover:underline" %>
    <% else %>
      <nav class="<%= pills %>" aria-label="Window">
        <% ProjectTimeline::WINDOWS.each_key do |key| %>
          <%= link_to key, current_page_with(time_range: key), class: pill.(key == @time_range),
              aria: {current: (key == @time_range ? "page" : nil)} %>
        <% end %>
      </nav>
    <% end %>

    <%# Each kind's count is the window's, under the name filter if there is one. %>
    <nav class="<%= pills %>" aria-label="Kind">
      <% [[nil, "All", all_count], *TransactionKind::KINDS.map { |k| [k, TransactionKind::LABELS[k], t.totals.dig(k, :count) || 0] }].each do |kind, label, count| %>
        <% next if kind == "other" && count.zero? && @kind != "other" %>
        <%= link_to (kind ? current_page_with(kind: kind) : current_page_with(drop: %w[kind])), class: pill.(@kind == kind),
            aria: {current: (@kind == kind ? "page" : nil)} do %>
          <%= label %> <span class="ml-0.5 font-mono tabular-nums text-gray-500 dark:text-gray-400"><%= timeline_k(count) %></span>
        <% end %>
      <% end %>
    </nav>

    <div class="ml-auto flex flex-wrap items-center gap-3 text-sm">
      <%# Permanent so a live refresh doesn't wipe what's being typed; the id
          carries the filters, so another window or kind gets a fresh form
          rather than this one's values. %>
      <%= form_with url: project_endpoints_path(@project.slug), method: :get,
          id: "endpoints-filter-#{Digest::MD5.hexdigest([@kind, @time_range, @window&.begin&.to_i, @environment, @name_query].to_json)[0, 12]}",
          data: {turbo_permanent: true}, class: "flex items-center gap-2" do |f| %>
        <% if @window %>
          <%= hidden_field_tag :from, @window.begin.utc.iso8601, id: nil %>
          <%= hidden_field_tag :to, @window.end.utc.iso8601, id: nil %>
        <% else %>
          <%= hidden_field_tag :time_range, @time_range, id: nil %>
        <% end %>
        <%= hidden_field_tag :kind, @kind, id: nil if @kind %>
        <%= hidden_field_tag :sort, @sort, id: nil if @sort == "slowest" %>
        <% if @environments.any? %>
          <%= f.select :environment, options_for_select([["every env", ""]] + @environments.map { |e| [e, e] }, @environment), {},
              class: "px-2 py-1 text-xs rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100",
              onchange: "this.form.requestSubmit()", aria: {label: "Environment"} %>
        <% end %>
        <%= f.search_field :name, value: @name_query, placeholder: "name contains…",
            class: "w-44 px-2 py-1 text-xs font-mono rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500",
            aria: {label: "Name"} %>
        <% if @name_query || @environment %>
          <%= link_to "clear", current_page_with(drop: %w[name environment]), class: "text-xs text-gray-600 dark:text-gray-400 hover:underline" %>
        <% end %>
      <% end %>
      <%= link_to "N+1 queries →", n_plus_one_project_endpoints_path(@project.slug, time_range: @time_range),
          class: "text-orange-700 dark:text-orange-300 hover:underline" %>
    </div>
  </div>

  <%= render layout: "projects/timeline/frame",
        locals: {timeline: t, buckets: t.cursor_buckets,
                 sizes: "[--lbl:9rem] md:[--lbl:15rem] [--val:12rem] md:[--val:14.5rem] [--gap:0.75rem]"} do %>
    <div class="<%= head %>"><span>Signals</span><span></span><span class="text-right"><%= @window ? timeline_window_label(@window) : t.window.key %></span></div>

    <% if t.kinds.empty? %>
      <div class="<%= row %> py-1.5 text-xs text-gray-500 dark:text-gray-400"><span class="col-span-3">No transactions in this window.</span></div>
    <% end %>

    <% t.kinds.each do |kind| %>
      <% s = t.signal(kind) %>
      <% tx = s.throughput %>
      <% settled = partial ? tx[0...-1] : tx %>
      <% pcts = s.percentiles %>
      <div class="<%= row %> py-1" data-signal="<%= kind %>">
        <div class="min-w-0"><div class="text-sm font-semibold"><%= signal_labels[kind] %></div><div class="text-[11px] text-gray-500 dark:text-gray-400"><%= nouns[kind] %> <%= per %>, as received</div></div>
        <% if tx.sum.positive? %>
          <% bars = timeline_bars(tx, height: 32, partial: partial) %>
          <svg viewBox="0 0 480 32" class="w-full h-8 cursor-pointer" preserveAspectRatio="none" aria-hidden="true"
               data-timeline-href="<%= project_endpoints_path(@project.slug, **filters, kind: kind) %>" data-timeline-hint="click for these <%= nouns[kind] %>">
            <path class="fill-gray-200 dark:fill-gray-800" d="<%= bars[:empty] %>"/>
            <path class="fill-blue-500 dark:fill-blue-400" d="<%= bars[:bars] %>"/>
            <path class="fill-blue-200 dark:fill-blue-900" d="<%= bars[:partial] %>"/>
          </svg>
        <% else %>
          <span class="text-xs text-gray-500 dark:text-gray-400">no <%= nouns[kind] %> in this window</span>
        <% end %>
        <div class="text-right tabular-nums">
          <div class="text-[15px] font-bold" data-count><%= number_with_delimiter(tx.sum) %></div>
          <div class="text-[11px] text-gray-500 dark:text-gray-400">pk <%= timeline_k(settled.max) %> · lo <%= timeline_k(settled.min) %></div>
        </div>
      </div>
      <div class="<%= row %> py-1" data-latency="<%= kind %>">
        <div class="min-w-0"><div class="text-sm font-semibold"><%= signal_labels[kind] %> p95</div><div class="text-[11px] text-gray-500 dark:text-gray-400"><%= per %>, every <%= kind == "job" ? "job" : "endpoint" %></div></div>
        <% if s.p95s.compact.any? %>
          <% line = timeline_line(s.p95s, height: 32) %>
          <svg viewBox="0 0 480 32" class="w-full h-8 cursor-pointer" preserveAspectRatio="none" aria-hidden="true"
               data-timeline-href="<%= project_endpoints_path(@project.slug, **filters, kind: kind, sort: "slowest") %>" data-timeline-hint="click for the slowest <%= nouns[kind] %>">
            <path class="fill-amber-500/15" d="<%= line[:area] %>"/>
            <path class="fill-none stroke-amber-500" stroke-width="1.5" stroke-linejoin="round" vector-effect="non-scaling-stroke" d="<%= line[:line] %>"/>
          </svg>
        <% else %>
          <span class="text-xs text-gray-500 dark:text-gray-400">nothing to time</span>
        <% end %>
        <div class="text-right tabular-nums">
          <div class="text-[15px] font-bold"><%= format_duration(pcts[:p50]) %> <span class="text-[11px] font-medium text-gray-500 dark:text-gray-400">p50</span></div>
          <div class="text-[11px] text-gray-500 dark:text-gray-400">p95 <%= format_duration(pcts[:p95]) %> · p99 <%= format_duration(pcts[:p99]) %></div>
        </div>
      </div>
    <% end %>

    <% scaled = t.scaled? %>
    <% t.kinds.each do |kind| %>
      <% endpoints = t.endpoints(kind) %>
      <% next if endpoints.empty? %>
      <% totals = t.totals[kind] %>
      <div class="<%= head %>" id="kind-<%= kind %>">
        <span class="truncate"><%= @kind ? "Where the time went" : section_labels[kind] %></span>
        <span class="<%= aside %> text-orange-700 dark:text-orange-300">
          <% if @kind %>
            p95 <%= per %> · time <%= scaled ? "scaled by each SDK's sample rate" : "as recorded" %>
          <% else %>
            where the time went: <%= (t.share(kind) * 100).round %>% of it<%= ", scaled by sample rate" if scaled %> ·
            <%= link_to "all #{timeline_k(totals[:count])} →", current_page_with(kind: kind), class: "text-blue-600 dark:text-blue-400 hover:underline" %>
          <% end %>
        </span>
        <span class="text-right whitespace-nowrap">time · count · p50 · p95</span>
      </div>
      <% endpoints.each do |endpoint| %>
        <%= render "endpoints/timeline_endpoint", endpoint: endpoint, timeline: t, project: @project, lane: row, per: per %>
      <% end %>
    <% end %>
  <% end %>

  <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
    <span class="inline-flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 bg-blue-500 dark:bg-blue-400"></span>count <%= per %></span>
    <% if partial %>
      <span class="inline-flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 bg-blue-200 dark:bg-blue-900"></span><%= timeline_bucket_noun(t) %> still running, left out of the low</span>
    <% end %>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block w-4 h-0.5 bg-amber-500"></span>p95 · dots when too few to say</span>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 border-l border-dashed border-violet-400"></span>deploy</span>
    <span>A name's kind is the op its SDK sends: <code class="font-mono">http.server</code> for requests, <code class="font-mono">queue.*</code> for jobs.</span>
  </div>

  <!-- The window's transactions -->
  <% noun = @kind ? nouns[@kind] : "transactions" %>
  <% http_columns = @kind != "job" %>
  <div class="mt-6">
    <div class="flex items-center justify-between gap-3 mb-2">
      <h2 class="text-[11px] font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400"><%= (@sort == "slowest") ? "Slowest" : "Recent" %> <%= noun %></h2>
      <%= render "endpoints/sort" %>
    </div>
    <% if @transactions.any? %>
      <div class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-sm overflow-x-auto">
        <table class="min-w-full text-xs">
          <thead class="text-[11px] uppercase tracking-wider text-gray-500 dark:text-gray-400">
            <tr class="border-b border-gray-100 dark:border-gray-800">
              <th class="px-3 py-2 text-left font-semibold">id</th>
              <th class="px-3 py-2 text-left font-semibold"><%= @kind == "job" ? "job" : "name" %></th>
              <% if http_columns %><th class="px-3 py-2 text-left font-semibold">request</th><% end %>
              <th class="px-3 py-2 text-right font-semibold">duration</th>
              <th class="px-3 py-2 text-left font-semibold">at (UTC)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            <% @transactions.each do |transaction| %>
              <% row_kind = @kind || @kind_lookup.kind_of(transaction.transaction_name) %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/60">
                <td class="px-3 py-1.5 font-mono text-gray-500 dark:text-gray-400">#<%= transaction.id %></td>
                <td class="px-3 py-1.5">
                  <%# Breaks after a :: or before a #, so a long controller name
                      wraps at its seams rather than widening the table. %>
                  <%= link_to project_transaction_path(@project.slug, transaction),
                      class: "font-mono text-gray-800 dark:text-gray-200 hover:underline mr-1.5" do %><%= safe_join(transaction.transaction_name.to_s.split(/(?<=::)|(?=#)/), tag.wbr) %><% end %>
                  <% if !@kind && row_kind != "web" %>
                    <span class="inline-block px-1 rounded border text-[10px] font-semibold text-teal-700 border-teal-300 dark:text-teal-300 dark:border-teal-800"><%= row_kind %></span>
                  <% end %>
                  <% if transaction.environment.present? %>
                    <span class="inline-block px-1 rounded border text-[10px] text-blue-700 border-blue-200 dark:text-blue-300 dark:border-blue-900"><%= transaction.environment %></span>
                  <% end %>
                </td>
                <% if http_columns %>
                  <td class="px-3 py-1.5 whitespace-nowrap">
                    <% if transaction.http_method.present? %><span class="font-mono text-gray-600 dark:text-gray-400 mr-1"><%= transaction.http_method %></span><% end %>
                    <%= render "projects/http_status_badge", status: transaction.http_status, size: "px-1 py-0.5 text-[10px]" %>
                  </td>
                <% end %>
                <td class="px-3 py-1.5 text-right whitespace-nowrap font-mono tabular-nums font-semibold text-gray-900 dark:text-gray-100"><%= format_duration(transaction.duration) %></td>
                <td class="px-3 py-1.5 whitespace-nowrap font-mono tabular-nums text-gray-500 dark:text-gray-400"><%= transaction.timestamp.utc.strftime("%-d %b %H:%M:%S") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-4 flex justify-center">
        <%= pagy_nav_countless_tailwind(@pagy) %>
      </div>
    <% else %>
      <div class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 text-center text-sm text-gray-500 dark:text-gray-400">
        No <%= noun %> in this window.
      </div>
    <% end %>
  </div>
</div>
