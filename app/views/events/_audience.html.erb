<%# Who a window's events came from (Analytics::Audience): one client
    hammering a page, or everyone? Each column counts the distinct values,
    names the commonest, and says how many events didn't say. %>
<% read = audience.read %>
<section class="mb-3 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 px-4 py-3" aria-label="Who the events came from">
  <% if read < total %>
    <p class="mb-2 text-xs text-gray-500 dark:text-gray-400">From the newest <%= number_with_delimiter(read) %> of <%= number_with_delimiter(total) %> events.</p>
  <% end %>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-x-5 gap-y-4">
    <% audience.dimensions.each do |dimension| %>
      <div data-dimension="<%= dimension.key %>" class="min-w-0">
        <div class="mb-1 text-xs font-semibold text-gray-900 dark:text-gray-100">
          <%= pluralize(number_with_delimiter(dimension.distinct), dimension.label) %>
        </div>
        <ul class="space-y-0.5">
          <% dimension.top.each do |value, n| %>
            <li class="relative flex items-baseline gap-2 font-mono text-xs" title="<%= value %>: <%= n %> of <%= read %>">
              <span class="absolute inset-y-0 left-0 rounded-sm bg-blue-100 dark:bg-blue-900/40" style="width: <%= (100.0 * n / read).round(1) %>%"></span>
              <span class="relative min-w-0 flex-1 truncate text-gray-800 dark:text-gray-200"><%= value %></span>
              <span class="relative shrink-0 tabular-nums text-gray-600 dark:text-gray-400"><%= number_with_delimiter(n) %></span>
            </li>
          <% end %>
        </ul>
        <% more = dimension.distinct - dimension.top.size %>
        <% if more.positive? || dimension.missing.positive? %>
          <div class="mt-1 text-xs text-gray-500 dark:text-gray-400">
            <%= safe_join([(("+#{number_with_delimiter(more)} more") if more.positive?),
                (("#{number_with_delimiter(dimension.missing)} not sent") if dimension.missing.positive?)].compact, " · ") %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
