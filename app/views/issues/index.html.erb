<%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @project, "issues" %>

<%# The issues list on the project page's clock (IssuesTimeline): the tab's
    events and its new issues as signal rows, then a row per issue on the page,
    each drawn on the one time axis, so a burst lines up with the deploy and
    the issues behind it. %>
<% t = @timeline %>
<% lane = "grid grid-cols-[var(--lbl)_minmax(0,1fr)_var(--val)] gap-x-(--gap) items-center" %>
<% row = "#{lane} border-t border-gray-100 dark:border-gray-800" %>
<% head = "#{lane} pt-4 pb-1 text-[11px] font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400" %>
<% aside = "normal-case tracking-normal font-normal" %>
<% per = timeline_per_bucket(t) %>
<% pill = ->(current) { "px-2.5 py-1 rounded text-xs font-medium whitespace-nowrap #{current ? "bg-white dark:bg-gray-700 text-gray-900 dark:text-white shadow-sm" : "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white"}" } %>
<% pills = "flex gap-0.5 p-0.5 rounded-md border border-gray-200 dark:border-gray-800 bg-gray-100 dark:bg-gray-900" %>
<% filters = {status: @status, environment: @environment}.compact %>
<% ev = t.events_per_bucket %>
<% fresh = t.first_seen_times %>
<%
  sorts = {
    "recent" => ["Recent", "Every #{@status} issue, last seen first"],
    "busiest" => ["Busiest", "The issues with events in this window, most first"],
    "new" => ["New", "The issues first seen in this window, newest first"]
  }
  listed = {
    "recent" => "every one, last seen first",
    "busiest" => "with events in this window, most first",
    "new" => "first seen in this window, newest first"
  }
%>

<div class="py-4">
  <div class="mb-1"><%= breadcrumbs([@project.name, project_path(@project.slug)], ["Issues", nil]) %></div>

  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-3">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Issues</h1>

    <% if @window %>
      <%= render "shared/window_steps", window: @window %>
      <%= link_to "last #{@window_key}", current_page_with(drop: %w[from to]),
          class: "text-sm text-blue-600 dark:text-blue-400 hover:underline" %>
    <% else %>
      <nav class="<%= pills %>" aria-label="Window">
        <% ProjectTimeline::WINDOWS.each_key do |key| %>
          <%= link_to key, current_page_with(window: key), class: pill.(key == @window_key),
              aria: {current: (key == @window_key ? "page" : nil)} %>
        <% end %>
      </nav>
    <% end %>

    <%# Each tab's count is every issue in it, whatever the window. %>
    <nav class="<%= pills %>" aria-label="Status">
      <% [["open", "Open", @open_count], ["resolved", "Resolved", @resolved_count], ["ignored", "Ignored", @ignored_count]].each do |status, label, count| %>
        <%= link_to current_page_with(status: status), class: pill.(@status == status),
            aria: {current: (@status == status ? "page" : nil)} do %>
          <%= label %> <span class="ml-0.5 font-mono tabular-nums text-gray-500 dark:text-gray-400"><%= number_with_delimiter(count) %></span>
        <% end %>
      <% end %>
    </nav>

    <nav class="<%= pills %>" aria-label="Sort">
      <% sorts.each do |sort, (label, title)| %>
        <%= link_to label, current_page_with(sort: sort), class: pill.(@sort == sort), title: title,
            aria: {current: (@sort == sort ? "page" : nil)} %>
      <% end %>
    </nav>

    <%# Only worth showing once events have been seen in more than one
        environment: a single-environment project gets no dropdown. %>
    <% if @environments.many? %>
      <%= form_with url: project_issues_path(@project.slug), method: :get, data: {turbo_frame: "_top"},
          class: "ml-auto flex items-center gap-2 text-sm" do |f| %>
        <% if @window %>
          <%= hidden_field_tag :from, @window.begin.utc.iso8601, id: nil %>
          <%= hidden_field_tag :to, @window.end.utc.iso8601, id: nil %>
        <% else %>
          <%= hidden_field_tag :window, @window_key, id: nil %>
        <% end %>
        <%= hidden_field_tag :status, @status, id: nil %>
        <%= hidden_field_tag :sort, @sort, id: nil %>
        <%= f.select :environment, options_for_select([["every env", ""]] + @environments.map { |e| [e, e] }, @environment), {},
            class: "px-2 py-1 text-xs rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100",
            onchange: "this.form.requestSubmit()", aria: {label: "Environment"} %>
        <% if @environment %>
          <%= link_to "clear", current_page_with(drop: %w[environment]), class: "text-xs text-gray-600 dark:text-gray-400 hover:underline" %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <% if @environment %>
    <p class="mb-2 text-xs text-gray-500 dark:text-gray-400">
      Issues seen at least once in <span class="font-medium"><%= @environment %></span>, and their events there.
      Issues group across environments, so these may also occur elsewhere.
    </p>
  <% end %>

  <%= render layout: "projects/timeline/frame",
        locals: {timeline: t, buckets: t.cursor_buckets,
                 sizes: "[--lbl:12rem] md:[--lbl:20rem] lg:[--lbl:24rem] [--val:9rem] md:[--val:11.5rem] [--gap:0.75rem]"} do %>
    <div class="<%= head %>"><span>Signals</span><span></span><span class="text-right"><%= @window ? timeline_window_label(@window) : t.window.key %></span></div>

    <div class="<%= row %> py-1" data-signal="events">
      <div class="min-w-0"><div class="text-sm font-semibold">Events</div><div class="text-[11px] text-gray-500 dark:text-gray-400">of <%= @status %> issues <%= per %></div></div>
      <% if ev.sum.positive? %>
        <% bars = timeline_bars(ev, height: 32) %>
        <svg viewBox="0 0 480 32" class="w-full h-8 cursor-pointer" preserveAspectRatio="none" aria-hidden="true"
             data-timeline-href="<%= project_issues_path(@project.slug, **filters, sort: "busiest") %>" data-timeline-hint="click for the issues busiest then">
          <path class="fill-gray-200 dark:fill-gray-800" d="<%= bars[:empty] %>"/>
          <path class="fill-red-500 dark:fill-red-400" d="<%= bars[:bars] %>"/>
        </svg>
      <% else %>
        <span class="text-xs text-gray-500 dark:text-gray-400">no events in this window</span>
      <% end %>
      <div class="text-right tabular-nums">
        <div class="text-[15px] font-bold" data-count><%= number_with_delimiter(ev.sum) %></div>
        <div class="text-[11px] text-gray-500 dark:text-gray-400">pk <%= number_with_delimiter(ev.max) %> <%= per %></div>
      </div>
    </div>

    <div class="<%= row %> py-1" data-signal="new">
      <div class="min-w-0"><div class="text-sm font-semibold">New issues</div><div class="text-[11px] text-gray-500 dark:text-gray-400">first seen, now <%= @status %></div></div>
      <% if fresh.any? %>
        <svg viewBox="0 0 480 24" class="w-full h-6 cursor-pointer" preserveAspectRatio="none" aria-hidden="true"
             data-timeline-href="<%= project_issues_path(@project.slug, **filters, sort: "new") %>" data-timeline-hint="click for the issues first seen then">
          <path class="stroke-gray-200 dark:stroke-gray-800" stroke-width="1" vector-effect="non-scaling-stroke" d="M0 23.5H480"/>
          <% if fresh.size <= ProjectTimeline::TICK_LIMIT %>
            <path class="stroke-emerald-500 dark:stroke-emerald-400" stroke-width="2" vector-effect="non-scaling-stroke"
                  d="<%= timeline_ticks(fresh.map { t.frac(it) }, top: 3, bottom: 23) %>"/>
          <% else %>
            <path class="fill-emerald-500 dark:fill-emerald-400" d="<%= timeline_bars(t.first_seen_per_bucket, height: 24)[:bars] %>"/>
          <% end %>
        </svg>
      <% else %>
        <span class="text-xs text-gray-500 dark:text-gray-400">none first seen in this window</span>
      <% end %>
      <div class="text-right text-[15px] font-bold tabular-nums" data-count><%= number_with_delimiter(fresh.size) %></div>
    </div>

    <div class="<%= head %>">
      <span><%= @status %> issues</span>
      <span class="<%= aside %>"><%= listed[@sort] %></span>
      <span class="text-right">window / all</span>
    </div>
    <% if @rows.any? %>
      <% @rows.each do |issue_row| %>
        <%= render "issues/timeline_issue", row: issue_row, timeline: t, project: @project, lane: row,
              burst_threshold: @burst_threshold, environments: @issue_environments[issue_row.issue.id],
              users: @issue_users[issue_row.issue.id] %>
      <% end %>
    <% else %>
      <div class="<%= row %> py-6 text-center">
        <div class="col-span-3">
          <% if @sort != "recent" %>
            <p class="text-sm text-gray-600 dark:text-gray-400">No <%= @status %> issues <%= @sort == "new" ? "were first seen" : "had events" %> in this window.</p>
          <% elsif @status == "open" %>
            <div class="text-4xl mb-2">🎉</div>
            <h3 class="text-base font-medium text-gray-900 dark:text-gray-100">No open issues</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Great job! Everything is looking good.</p>
          <% else %>
            <h3 class="text-base font-medium text-gray-900 dark:text-gray-100">No <%= @status %> issues</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400"><%= @status.capitalize %> issues will appear here.</p>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
    <span class="inline-flex items-center gap-1.5"><span class="inline-block w-px h-3 bg-red-500"></span>one event</span>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 bg-red-500 dark:bg-red-400"></span>events <%= per %>, past <%= ProjectTimeline::TICK_LIMIT %> in the window</span>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block w-0.5 h-3 bg-emerald-500"></span>an issue first seen</span>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 border-l border-dashed border-violet-400"></span>deploy</span>
  </div>

  <div class="mt-6 flex justify-center">
    <%= pagy_nav_tailwind(@pagy) %>
  </div>
</div>
