<%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @project, "issues" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <%= breadcrumbs([@project.name, project_path(@project.slug)],
                    ["Issues", nil]) %>
  </div>

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Issues</h1>
  </div>

  <!-- Status Tabs -->
  <div class="mb-6 border-b border-gray-200 dark:border-gray-800">
    <nav class="flex gap-8">
      <%= link_to project_issues_path(@project.slug, status: "open", environment: @environment),
          class: "py-4 px-1 border-b-2 font-medium text-sm #{@status == 'open' ? 'border-blue-500 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:border-gray-300 dark:hover:border-gray-700'}" do %>
        Open
        <span class="ml-2 py-0.5 px-2 rounded-full text-xs bg-gray-100 dark:bg-gray-800 dark:text-gray-300">
          <%= @open_count %>
        </span>
      <% end %>

      <%= link_to project_issues_path(@project.slug, status: "resolved", environment: @environment),
          class: "py-4 px-1 border-b-2 font-medium text-sm #{@status == 'resolved' ? 'border-blue-500 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:border-gray-300 dark:hover:border-gray-700'}" do %>
        Resolved
        <span class="ml-2 py-0.5 px-2 rounded-full text-xs bg-gray-100 dark:bg-gray-800 dark:text-gray-300">
          <%= @resolved_count %>
        </span>
      <% end %>

      <%= link_to project_issues_path(@project.slug, status: "ignored", environment: @environment),
          class: "py-4 px-1 border-b-2 font-medium text-sm #{@status == 'ignored' ? 'border-blue-500 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:border-gray-300 dark:hover:border-gray-700'}" do %>
        Ignored
        <span class="ml-2 py-0.5 px-2 rounded-full text-xs bg-gray-100 dark:bg-gray-800 dark:text-gray-300">
          <%= @ignored_count %>
        </span>
      <% end %>
    </nav>
  </div>

  <!-- Environment filter. Only worth showing once events have been seen in more
       than one environment — a single-environment project gets no dropdown. -->
  <% if @environments.many? %>
    <%= form_with url: project_issues_path(@project.slug), method: :get, data: {turbo_frame: "_top"},
        class: "mb-6 flex flex-wrap items-end gap-3" do |f| %>
      <%= f.hidden_field :status, value: @status %>
      <div>
        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Environment</label>
        <%= f.select :environment,
            options_for_select([["All", ""]] + @environments.map { |e| [e, e] }, @environment),
            {},
            class: "px-3 py-2 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
            onchange: "this.form.requestSubmit()" %>
      </div>
      <%= f.submit "Filter", class: "px-3 py-2 text-sm rounded-md bg-gray-100 dark:bg-gray-800 dark:text-gray-100 cursor-pointer" %>
    <% end %>
    <% if @environment %>
      <p class="-mt-3 mb-6 text-xs text-gray-500 dark:text-gray-400">
        Showing issues seen at least once in <span class="font-medium"><%= @environment %></span>.
        Issues group across environments, so these may also occur elsewhere.
      </p>
    <% end %>
  <% end %>

  <!-- Issues List -->
  <% if @issues.any? %>
    <div class="bg-white dark:bg-gray-900 rounded-lg shadow border border-gray-200 dark:border-gray-800 divide-y divide-gray-200 dark:divide-gray-800">
      <% @issues.each do |issue| %>
        <%= render "issues/issue_row", issue: issue, project: @project,
              sparkline: @sparklines[issue.id], deploy_markers: @deploy_markers,
              sparkline_range: @sparkline_range, burst_threshold: @burst_threshold,
              environments: @issue_environments[issue.id] %>
      <% end %>
    </div>

    <div class="mt-6 flex justify-center">
      <%= pagy_nav_tailwind(@pagy) %>
    </div>
  <% else %>
    <div class="bg-white dark:bg-gray-900 rounded-lg shadow p-12 text-center border border-gray-200 dark:border-gray-800">
      <% if @status == "open" %>
        <div class="text-6xl mb-4">🎉</div>
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-2">No open issues</h3>
        <p class="text-gray-600 dark:text-gray-400">Great job! Everything is looking good.</p>
      <% elsif @status == "resolved" %>
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-2">No resolved issues</h3>
        <p class="text-gray-600 dark:text-gray-400">Resolved issues will appear here.</p>
      <% else %>
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-2">No ignored issues</h3>
        <p class="text-gray-600 dark:text-gray-400">Ignored issues will appear here.</p>
      <% end %>
    </div>
  <% end %>
</div>
