<%# What one day of this retention setting costs on disk, from the storage %>
<%# snapshot (StorageStats.daily_usage). Renders nothing until a deep pass %>
<%# has run and the table holds at least a day of data. %>
<% if (u = daily_usage[setting]) %>
  <p class="text-xs text-gray-600 dark:text-gray-300 mt-1"
     title="Table + index bytes ÷ <%= u[:days] %> days of data held. An average over that window, not a live rate.">
    ≈ <strong><%= number_to_human_size(u[:bytes_per_day]) %>/day</strong>
    (<%= number_with_delimiter(u[:rows_per_day]) %> <%= rows_label %>)
    · ~<%= number_to_human_size(u[:bytes_per_day] * retention_days.to_i) %> at <%= retention_days %> days
  </p>
<% end %>
