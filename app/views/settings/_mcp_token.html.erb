<%# The `claude mcp add` command for one MCP token, as a copyable code block —
    shared by the per-user and instance panels, which differ in who owns the
    token, not in what you do with it. The token is masked until asked for, so
    the command survives a screenshot; Copy always copies the real thing.
    Locals: token (String), last_used_at (Time or nil). %>
<div class="rounded-lg border border-gray-200 dark:border-gray-800 overflow-hidden"
     data-controller="clipboard reveal"
     data-clipboard-text-value="<%= mcp_add_command(token) %>">
  <div class="flex items-center justify-between gap-3 px-3 py-2 bg-gray-100 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
    <span class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Add to Claude Code</span>

    <div class="flex items-center gap-1">
      <button type="button"
              data-action="reveal#toggle"
              class="text-xs font-medium text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white px-2 py-1 rounded cursor-pointer">
        <span data-reveal-target="label">Show token</span>
      </button>

      <button type="button"
              data-action="clipboard#copy"
              title="Copy command"
              class="flex items-center gap-1.5 text-xs font-medium text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white border border-gray-300 dark:border-gray-600 hover:bg-white dark:hover:bg-gray-700 px-2 py-1 rounded cursor-pointer">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3a1.5 1.5 0 0 1-1.5 1.5h-9a1.5 1.5 0 0 1-1.5-1.5v-12a1.5 1.5 0 0 1 1.5-1.5h3m1.5-3h7.5a1.5 1.5 0 0 1 1.5 1.5v12a1.5 1.5 0 0 1-1.5 1.5h-7.5a1.5 1.5 0 0 1-1.5-1.5v-12a1.5 1.5 0 0 1 1.5-1.5Z" />
        </svg>
        <span data-clipboard-target="feedback" data-copied-text="Copied!">Copy</span>
      </button>
    </div>
  </div>

  <%# One line, no ERB newlines: the block wraps rather than scrolls, so any %>
  <%# whitespace in the source would show up in the rendered command. %>
  <code class="block px-3 py-3 bg-gray-50 dark:bg-gray-950 font-mono text-xs leading-relaxed text-gray-800 dark:text-gray-200 break-words"><%= mcp_add_command_prefix %><span data-reveal-target="masked" class="text-gray-400 dark:text-gray-500 select-none">&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;</span><span data-reveal-target="plain" class="hidden text-blue-700 dark:text-blue-300"><%= token %></span>"</code>
</div>

<div class="flex flex-wrap items-center gap-3 mt-3">
  <%= button_to "Regenerate", reset_mcp_token_path,
        method: :post,
        form: {data: {turbo_confirm: "Regenerate this MCP token? Any client using the current one will stop working until you re-add it."}},
        class: "bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 text-sm font-semibold py-1.5 px-3 rounded-lg cursor-pointer" %>

  <span class="text-sm text-gray-500 dark:text-gray-400">
    <% if last_used_at %>
      Last used <%= time_ago_in_words(last_used_at) %> ago
    <% else %>
      Never used
    <% end %>
  </span>
</div>
