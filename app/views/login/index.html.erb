<div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-950 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div>
      <h1 class="text-center text-3xl font-bold text-gray-900 dark:text-gray-100">
        🐛💥 Splat
      </h1>
      <p class="mt-2 text-center text-sm text-gray-600 dark:text-gray-400">
        Simple, lightweight error tracking for developers
      </p>
    </div>

    <% if flash[:alert] %>
      <div class="mb-4 p-4 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 rounded-md">
        <p class="text-sm text-red-800 dark:text-red-300"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <% if flash[:notice] %>
      <div class="mb-4 p-4 bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 rounded-md">
        <p class="text-sm text-green-800 dark:text-green-300"><%= flash[:notice] %></p>
      </div>
    <% end %>

    <div class="bg-white dark:bg-gray-900 shadow rounded-lg p-6 border border-gray-200 dark:border-gray-800">
      <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 text-center mb-6">
        <%= authenticated? ? "Authentication Status" : "Login to Your Account" %>
      </h2>

      <% if authenticated? %>
        <div class="text-center space-y-4">
          <div class="text-green-600 dark:text-green-400">
            <svg class="inline-block w-8 h-8 mb-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </div>
          <p class="font-semibold text-gray-900 dark:text-gray-100">You are currently logged in</p>
          <p class="text-gray-600 dark:text-gray-400 text-sm">
            Signed in as <strong><%= current_user_email %></strong> via <%= current_user_provider %>
          </p>

          <div class="pt-4">
            <%= link_to "Continue to Dashboard", root_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 dark:bg-green-700 dark:hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 dark:focus:ring-offset-gray-900 transition-colors" %>
          </div>
        </div>
      <% elsif SplatAuthorization.oidc_configured? %>
        <div class="space-y-4">
          <%# An empty allowlist denies everyone. That's the right default, but %>
          <%# without this warning you find out by completing the whole provider %>
          <%# round trip and coming back to "your email is not authorized", %>
          <%# which reads like the user's fault rather than a missing variable. %>
          <% unless SplatAuthorization.allowlist_configured? %>
            <div class="p-4 bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-800 rounded-md">
              <p class="text-sm text-amber-800 dark:text-amber-300">
                <strong>No allowlist configured.</strong>
                Neither
                <code class="font-mono text-xs">SPLAT_ALLOWED_USERS</code> nor
                <code class="font-mono text-xs">SPLAT_ALLOWED_DOMAINS</code>
                is set, so every login will be denied once you return from the provider.
                Set one of them and restart Splat.
              </p>
            </div>
          <% end %>

          <p class="text-center text-gray-600 dark:text-gray-400">
            Click below to log in with your OpenID Connect provider:
          </p>

          <%= link_to(
            "OpenID Connect Login",
            "/login/start",
            class: "w-full flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:focus:ring-offset-gray-900 transition duration-150 ease-in-out text-center"
          ) %>
        </div>
      <% elsif SplatAuthorization.oidc_misconfigured? %>
        <div class="text-center space-y-4">
          <p class="text-red-600 dark:text-red-400">
            <svg class="inline-block w-8 h-8 mb-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h3a1 1 0 001-1v-3a1 1 0 000-2z" clip-rule="evenodd" />
            </svg>
          </p>

          <p class="font-semibold text-gray-900 dark:text-gray-100">Authentication Half-Configured</p>
          <p class="text-gray-600 dark:text-gray-400 text-sm">
            Some OpenID Connect settings are present but not all of them, so Splat is
            refusing to serve the UI rather than run unauthenticated. Missing:
          </p>
          <ul class="text-sm text-gray-900 dark:text-gray-100 space-y-1">
            <% SplatAuthorization.missing_oidc_vars.each do |var| %>
              <li><code class="font-mono text-xs bg-gray-100 dark:bg-gray-800 rounded px-1.5 py-0.5"><%= var %></code></li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <div class="text-center space-y-4">
          <p class="font-semibold text-gray-900 dark:text-gray-100">Authentication Not Enabled</p>
          <p class="text-gray-600 dark:text-gray-400 text-sm">
            This Splat instance has no OpenID Connect provider configured and is serving
            without authentication — its single-tenant default. There's nothing to log in to.
          </p>

          <div class="pt-2">
            <%= link_to "Continue to Dashboard", root_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:focus:ring-offset-gray-900 transition-colors" %>
          </div>
        </div>
      <% end %>

      <div class="mt-6 border-t border-gray-200 dark:border-gray-800 pt-6">
        <div class="text-center text-xs text-gray-500 dark:text-gray-400">
          <p>Need help? Contact your system administrator</p>
        </div>
      </div>
    </div>
  </div>
</div>
