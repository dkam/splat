<%# A monitor's row on the overview: its slug | its runs (the strip, drawn as
    projects/timeline/_monitor_strip says) | its schedule and its last run's
    length. The monitors page (monitors/_row) has more to each. %>
<% monitor = row.monitor %>
<div class="<%= lane %> py-1">
  <span class="truncate font-mono text-xs <%= row.failing? ? "font-semibold text-red-700 dark:text-red-300" : "text-gray-800 dark:text-gray-200" %>" title="<%= monitor.slug %>"><%= monitor.slug %></span>
  <%= render "projects/timeline/monitor_strip", row: row, timeline: timeline %>
  <div class="truncate text-right font-mono text-[11px] text-gray-500 dark:text-gray-400" title="<%= monitor.schedule_description %>">
    <%= timeline_schedule(monitor) %><% if monitor.last_duration %> · <%= format_time_spent(monitor.last_duration * 1000) %><% end %>
  </div>
</div>
