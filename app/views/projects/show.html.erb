<%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @project %>

<div class="py-4">
  <div class="mb-1"><%= breadcrumbs(["Projects", root_path], [@project.name, nil]) %></div>

  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-3">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= @project.name %></h1>

    <nav class="flex gap-0.5 p-0.5 rounded-md border border-gray-200 dark:border-gray-800 bg-gray-100 dark:bg-gray-900" aria-label="Window">
      <% ProjectTimeline::WINDOWS.each_key do |key| %>
        <% current = key == @timeline.window.key %>
        <%= link_to key, project_path(@project.slug, window: key),
            class: "px-2.5 py-1 rounded text-xs font-medium #{current ? "bg-white dark:bg-gray-700 text-gray-900 dark:text-white shadow-sm" : "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white"}",
            aria: {current: (current ? "page" : nil)} %>
      <% end %>
    </nav>

    <span class="font-mono text-xs text-gray-500 dark:text-gray-400">
      queue <%= @queue_depth %> · last event <%= @last_event_at ? time_ago_compact(@last_event_at, ago: true) : "never" %>
    </span>

    <div class="ml-auto flex items-center gap-2 text-sm">
      <button type="button" data-controller="clipboard" data-action="click->clipboard#copy" data-clipboard-text-value="<%= @project.dsn %>"
              class="bg-blue-600 hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-600 text-white text-xs font-semibold py-1.5 px-2.5 rounded-md">
        Copy DSN
      </button>
      <% if @project.internal_dsn.present? %>
        <button type="button" data-controller="clipboard" data-action="click->clipboard#copy" data-clipboard-text-value="<%= @project.internal_dsn %>"
                class="bg-green-600 hover:bg-green-700 dark:bg-green-700 dark:hover:bg-green-600 text-white text-xs font-semibold py-1.5 px-2.5 rounded-md">
          Internal DSN
        </button>
      <% end %>
      <%= link_to "Edit", edit_project_path(@project.slug), class: "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100" %>
      <%= button_to "Delete", project_path(@project.slug), method: :delete,
          data: {turbo_confirm: "Are you sure? This will delete all events and issues."},
          class: "text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300" %>
    </div>
  </div>

  <% if @timeline.widened_from %>
    <p class="mb-2 text-sm text-gray-600 dark:text-gray-400">
      Opened at <%= @timeline.window.key %>: the last <%= @timeline.widened_from %> had too little to draw.
      <%= link_to "Show #{@timeline.widened_from} anyway", project_path(@project.slug, window: @timeline.widened_from),
          class: "text-blue-600 dark:text-blue-400 hover:underline" %>
    </p>
  <% end %>

  <%= render "projects/timeline/card", timeline: @timeline, project: @project %>
</div>
